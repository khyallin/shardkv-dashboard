仓库shardkv是键值数据库的一个节点，仓库shardkv-dashboard是一个前后端分离的、键值数据库的管理系统。
你是这个项目的前端负责人，完成下面的 dashboard:

整个dashboard 分为左右两个部分：集群（左，占比大），数据（右，占比小）
集群：
一个列表，定时刷新，每个分片组一行，按gid升序排列，展示节点数量、分片组负载、分片信息（拥有的每个分片），以及一个“删除”按钮。
列表的最下面一行是一个‘+’号长按钮，用于新增一个分片组，风格与上面的每一行保持一致。
列表的左上角是标题”集群状态“，右上角是一个刷新icon，用于手动刷新；还有一个开关，用于打开自动负载均衡。
可以拖动分片从一个分片组到另一个分片组。
数据：
两个表单，一个 Get 和一个 Put。
Get表单只接受一个 key，不能为空，点击 Get 后显示 type、value、version 或报错信息.
Put表单接受key,type,value,version都不能为空，type为一个下拉单选框，可以选择 string, int, float, bool. 点击 Put 后显示成功或报错信息。

附录 后端接口设计：

- 获取集群配置信息 POST /api/v1/group/get
struct Req {}
struct Resp {
    code    int
    message string
    num     int
    shards  [NShards]int
    groups  map[int][]string
}

- 查询分片组状态 POST /api/v1/group/status
struct Req {
    gid int
}
struct Resp {
    code       int
	message    string
	totalQPS   float64
	doneQPS    float64
	successQPS float64
	maxLatency time.Duration
	avgLatency time.Duration
}

- 新增分片组 POST /api/v1/group/create
struct Req {
}
struct Resp {
    code    int
    message string
    gid     int
}

- 停止分片组 POST /api/v1/group/stop
struct Req {
    gid int
}
struct Resp {
    code    int
    message string
}

- 手动移动分片 POST /api/v1/config
struct Req {
    shard int
    from  int
    to    int
}
struct Resp {
    code    int
    message string
}

- 自动负载均衡 POST /api/v1/config/auto
struct Req {
    auto bool
}
struct Resp {
    code    int
    message string
}

- 查询键 POST /api/v1/kv/get
struct Req {
    key string
}
struct Resp {
    code    int
    message string
    type    string
    value   any
    version int
}

- 新增/修改键 POST /api/v1/kv/put
struct Req {
    key     string
    type    string
    value   any
    version int
}
struct Resp {
    code    int
    message string
}

- 运行压测 POST /api/v1/stress/run
struct Req {
    duration_sec int
    concurrency  int
    read_ratio   int
    value_size   int
    target_gid   int
    key_prefix   string
}
struct Resp {
    code       int
    message    string
    result     {
        duration_sec float64
        concurrency  int
        read_ratio   int
        value_size   int
        target_gid   int
        key_prefix   string
        total_ops    int64
        success_ops  int64
        failed_ops   int64
        read_ops     int64
        write_ops    int64
        tps          float64
        success_tps  float64
        avg_latency  time.Duration
        max_latency  time.Duration
        errors       {
            wrong_leader int64
            wrong_group  int64
            version_error int64
            other         int64
        }
        before_status {
            total_qps   float64
            done_qps    float64
            success_qps float64
            max_latency time.Duration
            avg_latency time.Duration
            err         string
        }
        after_status {
            total_qps   float64
            done_qps    float64
            success_qps float64
            max_latency time.Duration
            avg_latency time.Duration
            err         string
        }
    }
}
